<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_gray"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Racket Icon in Rounded Background -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_selected"
            android:padding="6dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_logo_racket"
                app:tint="@color/secondary" />
        </FrameLayout>

        <!-- Court Name & Time -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_court_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sân Pickleball B - Standard"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/on_background" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_clock_24"
                    app:tint="@color/secondary"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/text_court_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00 - 12:00 (3 Giờ)"
                    android:textSize="13sp"
                    android:textColor="@color/secondary" />
            </LinearLayout>

        </LinearLayout>

        <!-- Rates and Pricing -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp">



            <TextView
                android:id="@+id/text_court_total_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="450.000đ"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
