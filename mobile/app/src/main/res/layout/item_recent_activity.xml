<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_gray"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Avatar Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F3F5">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:src="@drawable/ic_person_24"
                app:tint="@color/secondary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Player & Booking details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/text_activity_player"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Văn A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"/>

            <TextView
                android:id="@+id/text_activity_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sân 01 • 14:00 - 16:00"
                android:textSize="13sp"
                android:textColor="#555555"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Price Pill Badge -->
        <TextView
            android:id="@+id/badge_activity_fee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$50.00"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/badge_empty"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:gravity="center"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
