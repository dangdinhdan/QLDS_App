<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <!-- Bullet Point / Icon container -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="•"
        android:textSize="20sp"
        android:textColor="@color/primary"
        android:layout_marginEnd="8dp"
        android:textStyle="bold"
        android:layout_gravity="top" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Court Name -->
        <TextView
            android:id="@+id/text_court_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sân Pickleball A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/on_background" />

        <!-- Hours Range and rate -->
        <TextView
            android:id="@+id/text_hours_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Khung giờ: 09:00 - 12:00 (150.000đ/h)"
            android:textSize="13sp"
            android:textColor="@color/secondary" />

        <!-- Fee -->
        <TextView
            android:id="@+id/text_court_fee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chi phí: 450.000đ"
            android:textSize="13sp"
            android:textColor="@color/secondary" />

    </LinearLayout>

</LinearLayout>
