<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".PriceTableDetailActivity">

    <!-- Top Sticky Header -->
    <RelativeLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_24"
            android:contentDescription="Back"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/text_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Chi tiết bảng giá"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/on_background"
            android:letterSpacing="-0.01" />

    </RelativeLayout>

    <!-- Scrollable Detail Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Breadcrumbs -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cấu hình › Bảng giá › Chi tiết"
                android:textSize="12sp"
                android:textColor="#556679"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp" />

            <!-- Main Title Banner -->
            <TextView
                android:id="@+id/text_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bảng giá sân Pickleball"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp"
                android:letterSpacing="-0.01" />

            <!-- Buttons row (Edit / Delete actions) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp">

                <!-- Edit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_detail_edit"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="Chỉnh sửa"
                    android:textSize="13sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/secondary"
                    app:icon="@drawable/ic_edit_24"
                    app:iconTint="@color/white"
                    app:iconSize="16dp"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="8dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <!-- Delete Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_detail_delete"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="Xóa"
                    android:textSize="13sp"
                    android:textColor="@color/tertiary"
                    android:textStyle="bold"
                    app:strokeColor="@color/tertiary"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_delete_24"
                    app:iconTint="@color/tertiary"
                    app:iconSize="16dp"
                    app:cornerRadius="8dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <!-- Card: Thông tin chung -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_gray"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thông tin chung"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:background="@color/surface_header"
                        android:padding="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tên bảng giá"
                            android:textSize="12sp"
                            android:textColor="#556679"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/text_info_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bảng giá sân Pickleball"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_background"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mã bảng giá"
                            android:textSize="12sp"
                            android:textColor="#556679"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/text_info_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BG_STANDARD"
                            android:textSize="14sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:background="@drawable/bg_price_status_badge"
                            android:backgroundTint="#F3F4F5"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mô tả"
                            android:textSize="12sp"
                            android:textColor="#556679"
                            android:layout_marginBottom="2dp" />
                        <TextView
                            android:id="@+id/text_info_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Áp dụng cho các ngày từ Thứ 2 đến Thứ 6 hàng tuần, không tính ngày lễ."
                            android:textSize="14sp"
                            android:textColor="#556679"
                            android:lineSpacingExtra="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Thống kê cấu hình -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_gray"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thống kê cấu hình"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:background="@color/surface_header"
                        android:padding="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_price_status_badge"
                            android:backgroundTint="@color/primary_container"
                            android:padding="12dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tổng khung giờ"
                                android:textSize="12sp"
                                android:textColor="@color/on_primary_container"
                                android:alpha="0.8" />

                            <TextView
                                android:id="@+id/text_stat_slots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_primary_container"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/bg_price_status_badge"
                            android:backgroundTint="@color/secondary_container"
                            android:padding="12dp"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ngày áp dụng"
                                android:textSize="12sp"
                                android:textColor="@color/on_secondary_container"
                                android:alpha="0.8" />

                            <TextView
                                android:id="@+id/text_stat_days"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="T2 - T6"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_secondary_container"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Chi tiết khung giờ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_gray"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chi tiết khung giờ"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:background="@color/surface_header"
                        android:padding="12dp"/>

                    <!-- List Table Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#F8F9FA"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="Khung giờ"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#556679" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Loại ngày"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#556679" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Đơn giá"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#556679"
                            android:gravity="end" />

                    </LinearLayout>

                    <!-- Dynamic Slots Container -->
                    <LinearLayout
                        android:id="@+id/layout_slots_table_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:divider="?android:attr/listDivider"
                        android:showDividers="middle" />

                    <!-- Bottom add slot placeholder -->
                    <TextView
                        android:id="@+id/button_add_time_slot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="+ Thêm khung giờ mới"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:gravity="center"
                        android:padding="12dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Sân áp dụng bảng giá -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_gray"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sân áp dụng bảng giá này"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:background="@color/surface_header"
                        android:padding="12dp"/>

                    <!-- Dynamic Courts list container -->
                    <LinearLayout
                        android:id="@+id/layout_linked_courts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:divider="?android:attr/listDivider"
                        android:showDividers="middle" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
