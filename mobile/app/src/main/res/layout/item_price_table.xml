<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_price_table_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_gray"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card Header with status badge and ID -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_header"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/badge_price_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐANG ÁP DỤNG"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary_container"
                android:background="@drawable/bg_price_status_badge"
                android:backgroundTint="@color/primary_container"
                android:gravity="center"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/text_price_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: BG-001"
                android:textSize="12sp"
                android:textColor="#556679"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />

        </RelativeLayout>

        <!-- Card Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title -->
            <TextView
                android:id="@+id/text_price_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bảng giá sân Pickleball"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginBottom="6dp"/>

            <!-- Description -->
            <TextView
                android:id="@+id/text_price_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Áp dụng cho các ngày từ Thứ 2 đến Thứ 6 hàng tuần, không tính ngày lễ."
                android:textSize="14sp"
                android:textColor="#556679"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="12dp"
                android:lineSpacingExtra="2dp" />

            <!-- Creation Date Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_calendar_24"
                    app:tint="#556679"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Calendar Icon" />

                <TextView
                    android:id="@+id/text_price_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tạo ngày: 15/10/2023"
                    android:textSize="13sp"
                    android:textColor="#556679" />

            </LinearLayout>

            <!-- Metadata badges: slots count and min price -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/badge_slots_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khung giờ: 4"
                    android:textSize="12sp"
                    android:textColor="#556679"
                    android:background="@drawable/bg_price_status_badge"
                    android:backgroundTint="#D2E4FB"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/badge_min_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá min: 120k"
                    android:textSize="12sp"
                    android:textColor="#556679"
                    android:background="@drawable/bg_price_status_badge"
                    android:backgroundTint="#D2E4FB"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_gray" />

        <!-- Actions tray -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical">

            <!-- Edit Button ("Sửa") -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_edit_price_table"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:text="Sửa"
                android:textSize="13sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_edit_24"
                app:iconTint="@color/primary"
                app:iconSize="16dp"
                app:cornerRadius="4dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- Detail Button ("Chi tiết") -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_detail_price_table"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="38dp"
                android:text="Chi tiết"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:icon="@drawable/ic_chevron_right_24"
                app:iconTint="@color/white"
                app:iconSize="16dp"
                app:iconGravity="textEnd"
                app:cornerRadius="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
