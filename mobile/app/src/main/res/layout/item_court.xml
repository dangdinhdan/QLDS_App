<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_court_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_gray"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Court Image & Status Badge Overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <ImageView
                android:id="@+id/image_court"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Pickleball Court Image" />

            <!-- Semi-transparent overlay for Maintenance -->
            <View
                android:id="@+id/view_maintenance_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#99E1E3E4"
                android:visibility="gone" />

            <TextView
                android:id="@+id/badge_court_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRỐNG"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary"
                android:background="@drawable/badge_empty"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:layout_margin="12dp"
                android:elevation="2dp" />

        </FrameLayout>

        <!-- Card Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title & Rate Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/text_court_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sân A1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_background"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <TextView
                    android:id="@+id/text_court_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$15.00/hr"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/secondary"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>

            </RelativeLayout>

            <!-- Surface Type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_courts_24"
                    app:tint="@color/secondary"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/text_surface_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mặt sân: Cứng"
                    android:textSize="13sp"
                    android:textColor="@color/secondary" />

            </LinearLayout>

            <!-- Status Details Info -->
            <LinearLayout
                android:id="@+id/layout_status_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="#F8F9FA"
                android:padding="8dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/image_detail_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_calendar_24"
                    app:tint="@color/secondary"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/text_court_details"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tiếp theo: 18:00 - Nguyễn Văn A"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface" />

            </LinearLayout>

            <!-- Card Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="4dp">

                <!-- Secondary action button (Change Status) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_change_status"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cập nhật"
                    android:textSize="13sp"
                    android:textColor="@color/secondary"
                    app:strokeColor="@color/secondary"
                    app:strokeWidth="1dp"
                    app:cornerRadius="4dp"
                    android:layout_marginEnd="8dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="12dp"/>

                <!-- Primary action button (Book Court) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_book_court"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đặt ngay"
                    android:textSize="13sp"
                    android:textColor="@color/on_primary_container"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_container"
                    app:cornerRadius="4dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="12dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
