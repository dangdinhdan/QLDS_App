<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".AddBookingActivity">

    <!-- Top Sticky Header -->
    <RelativeLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:elevation="2dp"
        app:layout_constraintWidth_max="680dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_24"
            android:contentDescription="Go Back"
            app:tint="@color/secondary" />

        <TextView
            android:id="@+id/text_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="PicklePro Manager"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:letterSpacing="-0.01" />

        <ImageButton
            android:id="@+id/button_notifications"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notification_24"
            android:contentDescription="Notifications"
            app:tint="@color/secondary" />

    </RelativeLayout>

    <!-- Scrollable Form Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintWidth_max="680dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Big Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phiếu đặt sân"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:letterSpacing="-0.01"/>

            <!-- Card 1: THÔNG TIN KHÁCH HÀNG -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_gray"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Card Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_person_24"
                            app:tint="@color/secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="THÔNG TIN KHÁCH HÀNG"
                            android:textSize="12sp"
                            android:textColor="@color/secondary"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                    </LinearLayout>

                    <!-- Input 1: Số điện thoại (sdt) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số điện thoại (bắt buộc)"
                        android:textSize="13sp"
                        android:textColor="@color/secondary"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edit_phone_number"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/input_field_bg"
                        android:hint="0xxx xxx xxx"
                        android:textColorHint="#9E9E9E"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:paddingHorizontal="12dp"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textCursorDrawable="@null" />

                    <!-- Input 2: Tên khách hàng -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Tên khách hàng"
                        android:textSize="13sp"
                        android:textColor="@color/secondary"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edit_customer_name"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/input_field_bg"
                        android:hint="Nhập tên"
                        android:textColorHint="#9E9E9E"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:paddingHorizontal="12dp"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:imeOptions="actionDone"
                        android:textCursorDrawable="@null" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Thông tin đặt sân -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_gray"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thông tin đặt sân"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_background"
                        android:layout_marginBottom="12dp"/>

                    <!-- Dynamic List of Selected Court Slots -->
                    <LinearLayout
                        android:id="@+id/layout_selected_courts_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_gray"
                        android:layout_marginVertical="16dp" />

                    <!-- Total Fee -->
                    <TextView
                        android:id="@+id/text_total_fee_display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tổng tạm tính: 0đ"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Save Button Layout -->
    <LinearLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp"
        android:elevation="4dp"
        app:layout_constraintWidth_max="680dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_booking"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Lưu đặt sân"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#191E00"
            app:backgroundTint="@color/primary_container"
            app:icon="@drawable/ic_check_circle_24"
            app:iconTint="#191E00"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
