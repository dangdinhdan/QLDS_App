<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_gray"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_header"
            android:padding="12dp">

            <TextView
                android:id="@+id/text_booking_player"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <TextView
                android:id="@+id/text_booking_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-06-11"
                android:textSize="13sp"
                android:textColor="@color/secondary"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"/>

        </RelativeLayout>

        <!-- Card Body -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/layout_booking_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/button_cancel_booking"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/text_booking_court"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Center Court"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"/>

                <TextView
                    android:id="@+id/text_booking_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time: 08:00 - 10:00"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/text_booking_fee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Fee: $50.00"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <!-- Cancel Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_cancel_booking"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textSize="13sp"
                android:textColor="@color/tertiary"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:minHeight="36dp"
                android:paddingHorizontal="8dp"/>

        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
