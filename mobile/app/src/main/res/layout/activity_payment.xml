<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".PaymentActivity">

    <!-- Top Sticky Header -->
    <RelativeLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_24"
            android:contentDescription="Go Back"
            app:tint="@color/secondary" />

        <TextView
            android:id="@+id/text_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/button_back"
            android:text="Thanh toán"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/on_background" />

    </RelativeLayout>

    <!-- Scrollable Billing Detail -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Booking ID & Customer Name -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_gray"
                app:cardBackgroundColor="@color/white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Left: Booking ID -->
                    <TextView
                        android:id="@+id/label_booking_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mã đặt sân"
                        android:textSize="12sp"
                        android:textColor="@color/secondary" />

                    <TextView
                        android:id="@+id/text_booking_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/label_booking_code"
                        android:layout_marginTop="4dp"
                        android:text="#BK-1024"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_background" />

                    <!-- Right: Customer Name -->
                    <TextView
                        android:id="@+id/label_customer_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Khách hàng"
                        android:textSize="12sp"
                        android:textColor="@color/secondary" />

                    <TextView
                        android:id="@+id/text_customer_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/label_customer_name"
                        android:layout_marginTop="4dp"
                        android:text="Nguyễn Văn A"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: CHI TIẾT DỊCH VỤ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_gray"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Card Header -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@color/surface_header"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="CHI TIẾT DỊCH VỤ"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary"
                        android:letterSpacing="0.05" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- List Container for Booked Courts -->
                        <LinearLayout
                            android:id="@+id/layout_booked_courts_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- Dashed Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@drawable/bg_dashed_divider"
                            android:layout_marginVertical="12dp"
                            android:layerType="software" />

                        <!-- Subtotal Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tạm tính"
                                android:textSize="14sp"
                                android:textColor="@color/secondary" />

                            <TextView
                                android:id="@+id/text_subtotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="450.000đ"
                                android:textSize="14sp"
                                android:textColor="@color/on_background"
                                android:textStyle="bold" />
                        </RelativeLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Box 3: TỔNG CỘNG THANH TOÁN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/primary"
                app:cardBackgroundColor="@color/primary_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TỔNG CỘNG THANH TOÁN"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_primary_container"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/text_total_fee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="450.000đ"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_primary_container" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Title: Phương thức thanh toán -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phương thức thanh toán"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/on_background"
                android:layout_marginBottom="12dp" />

            <!-- Card 4: Cash Option -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_gray"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <!-- Cash Icon -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="#F1F3F5"
                        android:padding="8dp"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_cash_24"
                            app:tint="@color/secondary" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Tiền mặt (Cash)"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_background" />

                    <!-- Radio Indicator Dot -->
                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:buttonTint="@color/primary" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Actions Layout -->
    <LinearLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_confirm_payment"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Xác nhận thanh toán"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#191E00"
            app:backgroundTint="@color/primary_container"
            app:icon="@drawable/ic_check_circle_24"
            app:iconTint="#191E00"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
